# Скопируйте в .env и заполните. Файл .env в Git не попадает.
NKT_API_KEY=ключ_API_Национального_каталога
TELEGRAM_BOT_TOKEN=токен_от_BotFather
BOT_ADMIN_USERS=123456789
BOT_ALLOWED_USERS=
BOT_INVITE_CODE=
# ИИ-помощник «Добавить товар» (необязательно)
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
AI_DAILY_LIMIT=50
AI_PHOTO_DAYS=30
AI_MONTHLY_BUDGET_USD=5
# Автоотправка карточек в каталог после «Верно» (0 — выключено)
AI_SUBMIT=0
AI_SUBMIT_DAILY=10
