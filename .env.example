# Скопируйте в .env (он не попадает в Git) и впишите свои значения.
NKT_API_KEY=ключ_портального_API_Национального_каталога
TELEGRAM_BOT_TOKEN=токен_бота_от_BotFather
BOT_ADMIN_USERS=123456789          # номера администраторов в Telegram через запятую
BOT_ALLOWED_USERS=                 # номера продавцов (можно пусто, если вход по коду)
BOT_INVITE_CODE=придумайте-код     # общий код входа: /join код
